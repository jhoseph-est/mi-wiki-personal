---
import '../styles/base.css';
import Header from '../components/Header.astro';
import LeftSidebar from '../components/LeftSidebar.astro';
import RightSidebar from '../components/RightSidebar.astro';
import { ClientRouter } from 'astro:transitions';

const {
  title,
  headings = [],
  frontmatter = {},
  docId,
  isLanding = false
} = Astro.props;

const estiloDoc = frontmatter.theme || 'moderno';
---

<!DOCTYPE html>
<html lang="es" data-estilo={estiloDoc}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} | Repositorio Personal</title>
    <ClientRouter />
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <script src="/pagefind/pagefind-ui.js" is:inline></script>
    <script is:inline>
      (function () {
        const html = document.documentElement;
        const body = document.body;
        const modo = localStorage.getItem('pref-modo') || 'oscuro';
        const texto = localStorage.getItem('pref-texto') || 'estandar';
        const ancho = localStorage.getItem('pref-ancho') || 'normal';

        html.setAttribute('data-modo', modo);
        html.setAttribute('data-texto', texto);
        html.setAttribute('data-ancho', ancho);
        if (body) body.setAttribute('data-modo', modo);

        document.addEventListener('astro:before-swap', (ev) => {
          const m = localStorage.getItem('pref-modo') || 'oscuro';
          const t = localStorage.getItem('pref-texto') || 'estandar';
          const a = localStorage.getItem('pref-ancho') || 'normal';
          const nuevoEstilo = ev.newDocument.documentElement.getAttribute('data-estilo') || 'moderno';

          ev.newDocument.documentElement.setAttribute('data-modo', m);
          ev.newDocument.documentElement.setAttribute('data-estilo', nuevoEstilo);
          ev.newDocument.documentElement.setAttribute('data-texto', t);
          ev.newDocument.documentElement.setAttribute('data-ancho', a);
          if (ev.newDocument.body) ev.newDocument.body.setAttribute('data-modo', m);
        });
      })();
    </script>
  <link 
    rel="stylesheet" 
    href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" 
    crossorigin="anonymous" 
  />
  </head>
  <body>
    <Header />

    <div class={`layout-grid ${isLanding ? 'landing-mode' : ''}`}>
      <aside class="sticky-panel left-panel hide-on-mobile">
        <LeftSidebar headings={headings} />
      </aside>

      <main class="main-content" data-pagefind-ignore>
        <div class="content-wrapper">
          <slot />
        </div>
      </main>

      <aside class="sticky-panel right-panel hide-on-tablet">
        <RightSidebar frontmatter={frontmatter} docId={docId} />
      </aside>
    </div>

    <!-- BOTÓN COPIAR CÓDIGO -->
    <script>
      document.addEventListener('astro:page-load', () => {
        document.querySelectorAll('.main-content pre').forEach((preNode) => {
          const pre = preNode as HTMLElement;
          const isMermaid = pre.getAttribute('data-language') === 'mermaid' || !!pre.querySelector('.language-mermaid');
          if (isMermaid || pre.querySelector('.copy-code-btn')) return;

          const btn = document.createElement('button');
          btn.className = 'copy-code-btn';
          btn.innerText = 'Copiar';

          btn.addEventListener('click', async () => {
            const codeEl = pre.querySelector('code');
            const code = codeEl ? codeEl.textContent : pre.textContent;
            if (!code) return;

            try {
              await navigator.clipboard.writeText(code);
              btn.innerText = '¡Copiado!';
              btn.classList.add('copied');
              setTimeout(() => {
                btn.innerText = 'Copiar';
                btn.classList.remove('copied');
              }, 2000);
            } catch (error) {
              console.error('Error al copiar:', error);
            }
          });

          pre.appendChild(btn);
        });
      });
    </script>

    <!-- INICIALIZADOR MODULAR DE MERMAID -->
    <script>
      import { renderMermaid } from '../utils/mermaidViewer';

      document.addEventListener('astro:page-load', () => renderMermaid(false));

      let themeTimeout: ReturnType<typeof setTimeout>;
      const observer = new MutationObserver((mutations) => {
        for (const mutation of mutations) {
          if (mutation.type === 'attributes' && mutation.attributeName === 'data-modo') {
            clearTimeout(themeTimeout);
            themeTimeout = setTimeout(() => {
              renderMermaid(true);
            }, 100);
          }
        }
      });

      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-modo']
      });
    </script>
    <!-- NUEVO SCRIPT PARA EVITAR QUE PAGEFIND DUPLIQUE EL CÓDIGO DE LAS FÓRMULAS -->
    <script>
      document.addEventListener('astro:page-load', () => {
        document.querySelectorAll('.katex-mathml, .katex-html').forEach(el => {
          if (!el.hasAttribute('data-pagefind-ignore')) {
            el.setAttribute('data-pagefind-ignore', 'true');
          }
        });
      });
    </script>
    <script>
  document.addEventListener('astro:page-load', () => {
    // 1. Cierre seguro de sidebars móviles al hacer clic fuera
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const leftPanel = document.querySelector('.left-panel');
      const rightPanel = document.querySelector('.right-panel');
      
      const isLeftOpen = leftPanel?.classList.contains('show-mobile-menu');
      const isRightOpen = rightPanel?.classList.contains('show-mobile-right');

      if (!isLeftOpen && !isRightOpen) return;

      const clickedInsideLeft = leftPanel?.contains(target);
      const clickedInsideRight = rightPanel?.contains(target);

      const clickedToggleButton = target.closest('button, a') && (
        target.closest('[id*="toggle"]') || 
        target.closest('[class*="menu"]') || 
        target.closest('header button')
      );

      if (clickedToggleButton) return;

      if (isLeftOpen && leftPanel && !clickedInsideLeft) {
        leftPanel.classList.remove('show-mobile-menu');
      }
      if (isRightOpen && rightPanel && !clickedInsideRight) {
        rightPanel.classList.remove('show-mobile-right');
      }
    });

    // 2. Control de scroll de fondo para modales (Mermaid / Grafo)
    const checkModals = () => {
      const mermaidModal = document.getElementById('mermaid-global-modal');
      const graphModal = document.getElementById('graph-modal');
      
      const isMermaidActive = mermaidModal?.classList.contains('is-active');
      const isGraphActive = graphModal?.classList.contains('active') || graphModal?.classList.contains('is-active');

      if (isMermaidActive || isGraphActive) {
        document.body.style.overflow = 'hidden';
      } else {
        document.body.style.overflow = '';
      }
    };

    document.addEventListener('click', () => {
      setTimeout(checkModals, 50);
    });
    
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        setTimeout(checkModals, 50);
      }
    });
  });
</script>
<script>
  document.addEventListener('astro:page-load', () => {
    // Función para manejar el scroll con compensación exacta del header (tipado estricto)
    const scrollToHash = (hash: string) => {
      if (!hash) return;
      const targetElement = document.querySelector(hash);
      const mainContent = document.querySelector('.main-content');
      const header = document.querySelector('.main-header');

      if (targetElement && mainContent) {
        // Obtenemos la altura real del header en tiempo real
        const headerHeight = header ? header.getBoundingClientRect().height : 60;
        
        // Calculamos la posición del elemento respecto al contenedor con scroll (.main-content)
        const elementPosition = targetElement.getBoundingClientRect().top;
        const currentScroll = mainContent.scrollTop;
        
        // Posición final exacta restando el alto del header para que nunca lo tape
        const offsetPosition = elementPosition + currentScroll - headerHeight - 20;

        mainContent.scrollTo({
          top: offsetPosition,
          behavior: 'smooth'
        });
      }
    };

    // Si la página carga directamente con un # en la URL
    if (window.location.hash) {
      setTimeout(() => scrollToHash(window.location.hash), 100);
    }

    // Interceptar clics en cualquier enlace interno que contenga un anclaje (#)
    document.addEventListener('click', (e: MouseEvent) => {
      const targetElement = e.target as HTMLElement | null;
      const target = targetElement?.closest('a') as HTMLAnchorElement | null;
      
      if (target && target.hash && target.origin === window.location.origin) {
        if (target.pathname === window.location.pathname) {
          e.preventDefault();
          history.pushState(null, '', target.hash);
          scrollToHash(target.hash);
        }
      }
    });
  });
</script>
  </body>
</html>