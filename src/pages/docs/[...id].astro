---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const allDocs = await getCollection('docs');
  return allDocs.map(doc => {
    const normalizedId = doc.id.replace(/\\/g, '/');
    const partes = normalizedId.split('/');
    const carpetaActual = partes.length > 1 ? partes.slice(0, -1).join('/') : '';
    
    const docsEnCarpeta = allDocs.filter(d => {
      const dPartes = d.id.replace(/\\/g, '/').split('/');
      const dCarpeta = dPartes.length > 1 ? dPartes.slice(0, -1).join('/') : '';
      return dCarpeta === carpetaActual;
    });
    
    docsEnCarpeta.sort((a, b) => {
      const ordenA = a.data.orden ?? 9999;
      const ordenB = b.data.orden ?? 9999;
      if (ordenA !== ordenB) return ordenA - ordenB;
      const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
      const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
      if (dateA !== dateB) return dateB - dateA;
      return a.id.localeCompare(b.id);
    });
    
    const index = docsEnCarpeta.findIndex(d => d.id === doc.id);
    const prev = index > 0 ? docsEnCarpeta[index - 1] : null;
    const next = index < docsEnCarpeta.length - 1 ? docsEnCarpeta[index + 1] : null;
    
    return {
      params: { id: normalizedId },
      props: { doc, prev, next },
    };
  });
}

const { doc, prev, next } = Astro.props;
const { Content, headings } = await render(doc);

// --- LÓGICA DE MIGAS DE PAN ---
const normalizedDocId = doc.id.replace(/\\/g, '/');
const breadcrumbs = normalizedDocId.split('/').slice(0, -1);

// --- LÓGICA DE TIEMPO DE LECTURA ---
const words = doc.body ? doc.body.split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.ceil(words / 200)); // 200 palabras por minuto

// Inyectamos el tiempo de lectura en el frontmatter para pasarlo al RightSidebar
const frontmatterConExtra = { ...doc.data, readingTime };
---

<Base title={doc.data.title} headings={headings} frontmatter={frontmatterConExtra}>
  
  <!-- MIGAS DE PAN (BREADCRUMBS) -->
  <nav class="breadcrumbs">
    <a href="/">Inicio</a> 
    {breadcrumbs.length > 0 && <span> &rsaquo; </span>}
    {breadcrumbs.map((folder, index) => (
      <span style="text-transform: capitalize;">
        {folder} {index < breadcrumbs.length - 1 && ' › '}
      </span>
    ))}
  </nav>

  <article>
    <Content />
  </article>

  <hr class="nav-divider" />
  <div class="doc-nav">
    {prev ? (
      <a href={`/docs/${prev.id.replace(/\\/g, '/')}`} class="nav-btn prev">
        <span class="nav-label">« Anterior</span>
        <span class="nav-title">{prev.data.title}</span>
      </a>
    ) : (
      <div class="nav-btn disabled prev">
        <span class="nav-label">« Anterior</span>
        <span class="nav-title">Inicio de sección</span>
      </div>
    )}
    {next ? (
      <a href={`/docs/${next.id.replace(/\\/g, '/')}`} class="nav-btn next">
        <span class="nav-label">Siguiente »</span>
        <span class="nav-title">{next.data.title}</span>
      </a>
    ) : (
      <div class="nav-btn disabled next">
        <span class="nav-label">Siguiente »</span>
        <span class="nav-title">Fin de sección</span>
      </div>
    )}
  </div>
</Base>

<style>
  .breadcrumbs {
    font-size: 0.85rem;
    opacity: 0.7;
    margin-bottom: 2rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .breadcrumbs a {
    color: var(--text-color);
    text-decoration: none;
    font-weight: 600;
  }
  .breadcrumbs a:hover {
    text-decoration: underline;
  }
</style>