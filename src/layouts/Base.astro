---
import '../styles/base.css';
import Header from '../components/Header.astro';
import LeftSidebar from '../components/LeftSidebar.astro';
import RightSidebar from '../components/RightSidebar.astro';
import { ClientRouter } from 'astro:transitions';
import FilterModal from '../components/FilterModal.astro';
import GlobalModal from '../components/GlobalModal.astro'; // <--- Importamos el nuevo componente

const {
  title,
  headings = [],
  frontmatter = {},
  docId,
  isLanding = false
} = Astro.props;

const estiloDoc = frontmatter.theme || 'moderno';
---

<!DOCTYPE html>
<html lang="es" data-estilo={estiloDoc}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} | Repositorio Personal</title>
    <ClientRouter />
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <script src="/pagefind/pagefind-ui.js" is:inline></script>
    <script is:inline>
      (function () {
        const html = document.documentElement;
        const body = document.body;
        const modo = localStorage.getItem('pref-modo') || 'oscuro';
        const texto = localStorage.getItem('pref-texto') || 'estandar';
        const ancho = localStorage.getItem('pref-ancho') || 'normal';

        html.setAttribute('data-modo', modo);
        html.setAttribute('data-texto', texto);
        html.setAttribute('data-ancho', ancho);
        if (body) body.setAttribute('data-modo', modo);

        document.addEventListener('astro:before-swap', (ev) => {
          const m = localStorage.getItem('pref-modo') || 'oscuro';
          const t = localStorage.getItem('pref-texto') || 'estandar';
          const a = localStorage.getItem('pref-ancho') || 'normal';
          const nuevoEstilo = ev.newDocument.documentElement.getAttribute('data-estilo') || 'moderno';

          ev.newDocument.documentElement.setAttribute('data-modo', m);
          ev.newDocument.documentElement.setAttribute('data-estilo', nuevoEstilo);
          ev.newDocument.documentElement.setAttribute('data-texto', t);
          ev.newDocument.documentElement.setAttribute('data-ancho', a);
          if (ev.newDocument.body) ev.newDocument.body.setAttribute('data-modo', m);
        });
      })();
    </script>
    <link 
      rel="stylesheet" 
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" 
      crossorigin="anonymous" 
    />
  </head>
  <body>
    <Header />
    <div class={`layout-grid ${isLanding ? 'landing-mode' : ''}`}>
       <aside class="sticky-panel left-panel hide-on-mobile">
         <LeftSidebar headings={headings} />
       </aside>
       <main class="main-content" data-pagefind-ignore>
         <div class="content-wrapper">
           <slot />
         </div>
       </main>
       <aside class="sticky-panel right-panel hide-on-tablet">
         <RightSidebar frontmatter={frontmatter} docId={docId} />
       </aside>
     </div>
     
     <FilterModal />
     <GlobalModal /> <!-- <--- Renderizamos el modal global aquí -->

    <script>
      import { renderMermaid } from '../utils/mermaidViewer';

      document.addEventListener('astro:page-load', () => {
        // ==========================================
        // 1. BOTÓN COPIAR CÓDIGO
        // ==========================================
        document.querySelectorAll('.main-content pre').forEach((preNode) => {
          const pre = preNode as HTMLElement;
          const isMermaid = pre.getAttribute('data-language') === 'mermaid' || !!pre.querySelector('.language-mermaid');
          if (isMermaid || pre.querySelector('.copy-code-btn')) return;

          const btn = document.createElement('button');
          btn.className = 'copy-code-btn';
          btn.innerText = 'Copiar';

          btn.addEventListener('click', async () => {
            const codeEl = pre.querySelector('code');
            const code = codeEl ? codeEl.textContent : pre.textContent;
            if (!code) return;

            try {
              await navigator.clipboard.writeText(code);
              btn.innerText = '¡Copiado!';
              btn.classList.add('copied');
              setTimeout(() => {
                btn.innerText = 'Copiar';
                btn.classList.remove('copied');
              }, 2000);
            } catch (error) {
              console.error('Error al copiar:', error);
            }
          });

          pre.appendChild(btn);
        });

        // ==========================================
        // 2. INICIALIZADOR DE MERMAID
        // ==========================================
        renderMermaid(false);

        // ==========================================
        // 3. AISLAMIENTO DE PAGEFIND EN FÓRMULAS
        // ==========================================
        document.querySelectorAll('.katex-mathml, .katex-html').forEach(el => {
          if (!el.hasAttribute('data-pagefind-ignore')) {
            el.setAttribute('data-pagefind-ignore', 'true');
          }
        });

        // ==========================================
        // 4. GESTIÓN CENTRALIZADA DE OVERFLOW (MODALES)
        // ==========================================
        const checkModals = () => {
          const globalModal = document.getElementById('global-modal');
          const filterModal = document.getElementById('filter-modal');
          const graphModal = document.getElementById('graph-modal'); // Por retrocompatibilidad temporal si existe
          
          const isGlobalActive = globalModal?.classList.contains('is-active');
          const isFilterActive = filterModal?.classList.contains('is-active');
          const isGraphActive = graphModal?.classList.contains('active') || graphModal?.classList.contains('is-active');

          if (isGlobalActive || isFilterActive || isGraphActive) {
            document.body.style.overflow = 'hidden';
          } else {
            document.body.style.overflow = '';
          }
        };

        // Escucha global para abrir el modal unificado mediante eventos
        window.addEventListener('open-global-modal', ((e: CustomEvent) => {
          const { title, subtitle, contentHTML } = e.detail || {};
          const modal = document.getElementById('global-modal');
          const titleEl = document.getElementById('global-modal-title');
          const subtitleEl = document.getElementById('global-modal-subtitle');
          const bodyEl = document.getElementById('global-modal-body');

          if (titleEl) titleEl.textContent = title || '';
          if (subtitleEl) subtitleEl.textContent = subtitle || '';
          if (bodyEl && contentHTML) {
            bodyEl.innerHTML = '';
            if (typeof contentHTML === 'string') {
              bodyEl.innerHTML = contentHTML;
            } else if (contentHTML instanceof HTMLElement) {
              bodyEl.appendChild(contentHTML);
            }
          }

          modal?.classList.add('is-active');
          checkModals();
        }) as EventListener);

        const closeGlobalModal = () => {
          const modal = document.getElementById('global-modal');
          modal?.classList.remove('is-active');
          checkModals();
        };

        document.getElementById('global-modal-close')?.addEventListener('click', closeGlobalModal);
        document.getElementById('global-modal')?.addEventListener('click', (e) => {
          if (e.target === document.getElementById('global-modal')) closeGlobalModal();
        });

        // ==========================================
        // 5. NAVEGACIÓN Y SCROLL POR HASH (#)
        // ==========================================
        document.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;

          // Cierre de sidebars móviles
          const leftPanel = document.querySelector('.left-panel');
          const rightPanel = document.querySelector('.right-panel');
          const isLeftOpen = leftPanel?.classList.contains('show-mobile-menu');
          const isRightOpen = rightPanel?.classList.contains('show-mobile-right');

          if (isLeftOpen || isRightOpen) {
            const clickedInsideLeft = leftPanel?.contains(target);
            const clickedInsideRight = rightPanel?.contains(target);
            const clickedToggleButton = target.closest('button, a') && (
              target.closest('[id*="toggle"]') || 
              target.closest('[class*="menu"]') || 
              target.closest('header button')
            );

            if (!clickedToggleButton) {
              if (isLeftOpen && leftPanel && !clickedInsideLeft) leftPanel.classList.remove('show-mobile-menu');
              if (isRightOpen && rightPanel && !clickedInsideRight) rightPanel.classList.remove('show-mobile-right');
            }
          }

          // Intercepción de Anclajes (#)
          const link = target.closest('a') as HTMLAnchorElement | null;
          if (link) {
            const href = link.getAttribute('href') || '';
            if (href.includes('#') && !href.startsWith('http')) {
              const [path, rawHash] = href.split('#');
              const currentPath = window.location.pathname;
              if (!path || currentPath.endsWith(path) || path === '') {
                try {
                  // Selector de atributos [id="..."] es totalmente inmune a IDs numéricos o símbolos
                  const targetEl = document.querySelector(`[id="${CSS.escape(rawHash)}"]`);
                  if (targetEl) {
                    e.preventDefault();
                    history.pushState(null, '', '#' + rawHash);
                    targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    return;
                  }
                } catch (err) {
                  console.warn('Error al navegar al anclaje:', err);
                }
              }
            }
          }
        });

        // ==========================================
        // 6. GESTIÓN DE TECLADO (ESC)
        // ==========================================
        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            closeGlobalModal();
            const filterModal = document.getElementById('filter-modal');
            filterModal?.classList.remove('is-active');
            setTimeout(checkModals, 50);
          }
        });
      });

      // Observador de cambios de tema para Mermaid
      let themeTimeout: ReturnType<typeof setTimeout>;
      const observer = new MutationObserver((mutations) => {
        for (const mutation of mutations) {
          if (mutation.type === 'attributes' && mutation.attributeName === 'data-modo') {
            clearTimeout(themeTimeout);
            themeTimeout = setTimeout(() => {
              renderMermaid(true);
            }, 100);
          }
        }
      });

      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-modo']
      });
    </script>
  </body>
</html>