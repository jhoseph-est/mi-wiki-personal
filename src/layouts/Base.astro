---
import '../styles/base.css';
import Header from '../components/Header.astro';
import LeftSidebar from '../components/LeftSidebar.astro';
import RightSidebar from '../components/RightSidebar.astro';
import { ClientRouter } from 'astro:transitions';
import FilterModal from '../components/FilterModal.astro';

const {
  title,
  headings = [],
  frontmatter = {},
  docId,
  isLanding = false
} = Astro.props;

const estiloDoc = frontmatter.theme || 'moderno';
---

<!DOCTYPE html>
<html lang="es" data-estilo={estiloDoc}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} | Repositorio Personal</title>
    <ClientRouter />
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <script src="/pagefind/pagefind-ui.js" is:inline></script>
    <script is:inline>
      (function () {
        const html = document.documentElement;
        const body = document.body;
        const modo = localStorage.getItem('pref-modo') || 'oscuro';
        const texto = localStorage.getItem('pref-texto') || 'estandar';
        const ancho = localStorage.getItem('pref-ancho') || 'normal';

        html.setAttribute('data-modo', modo);
        html.setAttribute('data-texto', texto);
        html.setAttribute('data-ancho', ancho);
        if (body) body.setAttribute('data-modo', modo);

        document.addEventListener('astro:before-swap', (ev) => {
          const m = localStorage.getItem('pref-modo') || 'oscuro';
          const t = localStorage.getItem('pref-texto') || 'estandar';
          const a = localStorage.getItem('pref-ancho') || 'normal';
          const nuevoEstilo = ev.newDocument.documentElement.getAttribute('data-estilo') || 'moderno';

          ev.newDocument.documentElement.setAttribute('data-modo', m);
          ev.newDocument.documentElement.setAttribute('data-estilo', nuevoEstilo);
          ev.newDocument.documentElement.setAttribute('data-texto', t);
          ev.newDocument.documentElement.setAttribute('data-ancho', a);
          if (ev.newDocument.body) ev.newDocument.body.setAttribute('data-modo', m);
        });
      })();
    </script>
    <link 
      rel="stylesheet" 
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" 
      crossorigin="anonymous" 
    />
  </head>
  <body>
    <Header />
    <div class={`layout-grid ${isLanding ? 'landing-mode' : ''}`}>
       <aside class="sticky-panel left-panel hide-on-mobile">
         <LeftSidebar headings={headings} />
       </aside>
       <main class="main-content" data-pagefind-ignore>
         <div class="content-wrapper">
           <slot />
         </div>
       </main>
       <aside class="sticky-panel right-panel hide-on-tablet">
         <RightSidebar frontmatter={frontmatter} docId={docId} />
       </aside>
     </div>
     
     <FilterModal />

    <!-- SCRIPT GLOBAL UNIFICADO (Optimizado para ciclo de vida de Astro) -->
    <script>
      import { renderMermaid } from '../utils/mermaidViewer';

      document.addEventListener('astro:page-load', () => {
        // ==========================================
        // 1. BOTÓN COPIAR CÓDIGO
        // ==========================================
        document.querySelectorAll('.main-content pre').forEach((preNode) => {
          const pre = preNode as HTMLElement;
          const isMermaid = pre.getAttribute('data-language') === 'mermaid' || !!pre.querySelector('.language-mermaid');
          if (isMermaid || pre.querySelector('.copy-code-btn')) return;

          const btn = document.createElement('button');
          btn.className = 'copy-code-btn';
          btn.innerText = 'Copiar';

          btn.addEventListener('click', async () => {
            const codeEl = pre.querySelector('code');
            const code = codeEl ? codeEl.textContent : pre.textContent;
            if (!code) return;

            try {
              await navigator.clipboard.writeText(code);
              btn.innerText = '¡Copiado!';
              btn.classList.add('copied');
              setTimeout(() => {
                btn.innerText = 'Copiar';
                btn.classList.remove('copied');
              }, 2000);
            } catch (error) {
              console.error('Error al copiar:', error);
            }
          });

          pre.appendChild(btn);
        });

        // ==========================================
        // 2. INICIALIZADOR DE MERMAID
        // ==========================================
        renderMermaid(false);

        // ==========================================
        // 3. AISLAMIENTO DE PAGEFIND EN FÓRMULAS
        // ==========================================
        document.querySelectorAll('.katex-mathml, .katex-html').forEach(el => {
          if (!el.hasAttribute('data-pagefind-ignore')) {
            el.setAttribute('data-pagefind-ignore', 'true');
          }
        });

        // ==========================================
        // 4. GESTIÓN DE SIDEBARS MÓVILES Y MODALES
        // ==========================================
        const checkModals = () => {
          const mermaidModal = document.getElementById('mermaid-global-modal');
          const graphModal = document.getElementById('graph-modal');
          const filterModal = document.getElementById('filter-modal');
          
          const isMermaidActive = mermaidModal?.classList.contains('is-active');
          const isGraphActive = graphModal?.classList.contains('active') || graphModal?.classList.contains('is-active');
          const isFilterActive = filterModal?.classList.contains('is-active');

          if (isMermaidActive || isGraphActive || isFilterActive) {
            document.body.style.overflow = 'hidden';
          } else {
            document.body.style.overflow = '';
          }
        };

        // ==========================================
        // 5. NAVEGACIÓN Y SCROLL POR HASH (#)
        // ==========================================
        const scrollToHash = (hash: string) => {
          if (!hash) return;
          const targetElement = document.querySelector(hash);
          const mainContent = document.querySelector('.main-content');
          const header = document.querySelector('.main-header');
          
          if (targetElement && mainContent) {
            const headerHeight = header ? header.getBoundingClientRect().height : 60;
            const elementPosition = targetElement.getBoundingClientRect().top;
            const currentScroll = mainContent.scrollTop;
            const offsetPosition = elementPosition + currentScroll - headerHeight - 20;
            
            mainContent.scrollTo({
              top: offsetPosition,
              behavior: 'smooth'
            });
          }
        };

        if (window.location.hash) {
          setTimeout(() => scrollToHash(window.location.hash), 100);
        }

        // ==========================================
        // 6. GESTIÓN CENTRALIZADA DE CLICS GLOBALES
        // ==========================================
        let allDocsCache: any[] = [];

        async function getDocs() {
          if (allDocsCache.length > 0) return allDocsCache;
          try {
            const res = await fetch('/api/filter.json');
            allDocsCache = await res.json();
            return allDocsCache;
          } catch (err) {
            console.error('Error cargando índice de filtros:', err);
            return [];
          }
        }

        const filterModal = document.getElementById('filter-modal');
        const modalTitle = document.getElementById('filter-modal-title');
        const modalBadge = document.getElementById('filter-modal-badge');
        const modalList = document.getElementById('filter-modal-list');
        const closeBtn = filterModal?.querySelector('.filter-modal-close');

        function closeFilterModal() {
          filterModal?.classList.remove('is-active');
          checkModals();
        }

        closeBtn?.addEventListener('click', closeFilterModal);
        filterModal?.addEventListener('click', (e) => {
          if (e.target === filterModal) closeFilterModal();
        });

        document.addEventListener('click', async (e) => {
          const target = e.target as HTMLElement;

          // A. Cierre de sidebars móviles al hacer clic fuera
          const leftPanel = document.querySelector('.left-panel');
          const rightPanel = document.querySelector('.right-panel');
          const isLeftOpen = leftPanel?.classList.contains('show-mobile-menu');
          const isRightOpen = rightPanel?.classList.contains('show-mobile-right');

          if (isLeftOpen || isRightOpen) {
            const clickedInsideLeft = leftPanel?.contains(target);
            const clickedInsideRight = rightPanel?.contains(target);
            const clickedToggleButton = target.closest('button, a') && (
              target.closest('[id*="toggle"]') || 
              target.closest('[class*="menu"]') || 
              target.closest('header button')
            );

            if (!clickedToggleButton) {
              if (isLeftOpen && leftPanel && !clickedInsideLeft) leftPanel.classList.remove('show-mobile-menu');
              if (isRightOpen && rightPanel && !clickedInsideRight) rightPanel.classList.remove('show-mobile-right');
            }
          }

          // B. Intercepción de Anclajes (#)
          const link = target.closest('a') as HTMLAnchorElement | null;
          if (link) {
            const href = link.getAttribute('href') || '';
            if (href.includes('#') && !href.startsWith('http')) {
              const [path, hash] = href.split('#');
              const currentPath = window.location.pathname;
              if (!path || currentPath.endsWith(path) || path === '') {
                const targetEl = document.getElementById(hash);
                if (targetEl) {
                  e.preventDefault();
                  history.pushState(null, '', '#' + hash);
                  scrollToHash('#' + hash);
                  return;
                }
              }
            }
          }

          // C. Intercepción de Filtros (Sidebar Right)
          const trigger = target.closest('.filter-trigger') as HTMLElement;
          if (trigger) {
            e.preventDefault();
            e.stopImmediatePropagation();

            const type = trigger.getAttribute('data-type');
            const rawValue = trigger.getAttribute('data-value') || '';

            const docs = await getDocs();
            let filtered: any[] = [];
            let badgeText = '';
            let titleText = '';

            if (type === 'tags') {
              badgeText = 'Etiqueta';
              titleText = `#${rawValue}`;
              filtered = docs.filter(d => d.tags && d.tags.includes(rawValue));
            } else if (type === 'curso') {
              badgeText = 'Asignatura';
              titleText = rawValue;
              filtered = docs.filter(d => d.curso === rawValue);
            } else if (type === 'ciclo') {
              badgeText = 'Nivel Académico';
              titleText = `Ciclo ${rawValue}`;
              filtered = docs.filter(d => String(d.ciclo) === rawValue);
            } else if (type === 'dificultad') {
              badgeText = 'Dificultad';
              titleText = rawValue;
              filtered = docs.filter(d => d.dificultad === rawValue);
            } else if (type === 'autor') {
              badgeText = 'Autor';
              titleText = rawValue;
              filtered = docs.filter(d => d.author === rawValue);
            }

            if (modalBadge) modalBadge.textContent = badgeText;
            if (modalTitle) modalTitle.textContent = titleText;
            
            if (modalList) {
              modalList.innerHTML = filtered.length > 0 
                ? filtered.map(doc => {
                    return `
                      <li>
                        <a href="/docs/${doc.id}" class="filter-card-item">
                          <span class="card-icon">📄</span>
                          <h3>${doc.title}</h3>
                        </a>
                      </li>
                    `;
                  }).join('')
                : '<p style="text-align:center; opacity:0.6; padding: 2rem 0; grid-column: 1 / -1;">No se encontraron apuntes con este filtro.</p>';
            }

            filterModal?.classList.add('is-active');
            checkModals();
          }
        });

        // ==========================================
        // 7. GESTIÓN DE TECLADO (ESC)
        // ==========================================
        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            closeFilterModal();
            const graphModal = document.getElementById('graph-modal');
            if (graphModal) graphModal.classList.remove('active', 'is-active');
            setTimeout(checkModals, 50);
          }
        });
      });

      // Observador de cambios de tema para Mermaid
      let themeTimeout: ReturnType<typeof setTimeout>;
      const observer = new MutationObserver((mutations) => {
        for (const mutation of mutations) {
          if (mutation.type === 'attributes' && mutation.attributeName === 'data-modo') {
            clearTimeout(themeTimeout);
            themeTimeout = setTimeout(() => {
              renderMermaid(true);
            }, 100);
          }
        }
      });

      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-modo']
      });
    </script>
  </body>
</html>