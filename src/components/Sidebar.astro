---
import { getCollection } from 'astro:content';
import ThemeSelector from './ThemeSelector.astro'; // Importamos el selector

const docs = await getCollection('docs');
---

<aside class="sidebar">
  <!-- Colocamos el selector aquí -->
  <ThemeSelector /> 
  
  <hr style="border-color: var(--text-color); opacity: 0.2; margin-bottom: 2rem;" />

  <h3>Mis Notas</h3>
  <ul>
    {docs.map(doc => (
      <li>
        <a href={`/docs/${doc.id}`}>{doc.data.title}</a>
      </li>
    ))}
  </ul>
</aside>

<style>
  /* Mantenemos tus estilos anteriores */
  .sidebar {
    min-width: 250px;
    border-right: 1px solid var(--text-color);
    padding-right: 1rem;
    opacity: 0.9;
  }
  ul { list-style: none; padding: 0; }
  li { margin-bottom: 0.5rem; }
  a { color: var(--text-color); text-decoration: none; }
  a:hover { font-weight: bold; }
</style>