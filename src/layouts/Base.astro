---
import '../styles/base.css';
import Header from '../components/Header.astro';
import LeftSidebar from '../components/LeftSidebar.astro';
import RightSidebar from '../components/RightSidebar.astro';
import { ClientRouter } from 'astro:transitions';

const {
  title,
  headings = [],
  frontmatter = {},
  docId,
  isLanding = false
} = Astro.props;

const estiloDoc = frontmatter.theme || 'moderno';
---

<!DOCTYPE html>
<html lang="es" data-estilo={estiloDoc}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} | Repositorio Personal</title>
    <ClientRouter />
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <script src="/pagefind/pagefind-ui.js" is:inline></script>
    <script is:inline>
      (function () {
        const html = document.documentElement;
        const body = document.body;
        const modo = localStorage.getItem('pref-modo') || 'oscuro';
        const texto = localStorage.getItem('pref-texto') || 'estandar';
        const ancho = localStorage.getItem('pref-ancho') || 'normal';

        html.setAttribute('data-modo', modo);
        html.setAttribute('data-texto', texto);
        html.setAttribute('data-ancho', ancho);
        if (body) body.setAttribute('data-modo', modo);

        document.addEventListener('astro:before-swap', (ev) => {
          const m = localStorage.getItem('pref-modo') || 'oscuro';
          const t = localStorage.getItem('pref-texto') || 'estandar';
          const a = localStorage.getItem('pref-ancho') || 'normal';
          const nuevoEstilo = ev.newDocument.documentElement.getAttribute('data-estilo') || 'moderno';

          ev.newDocument.documentElement.setAttribute('data-modo', m);
          ev.newDocument.documentElement.setAttribute('data-estilo', nuevoEstilo);
          ev.newDocument.documentElement.setAttribute('data-texto', t);
          ev.newDocument.documentElement.setAttribute('data-ancho', a);
          if (ev.newDocument.body) ev.newDocument.body.setAttribute('data-modo', m);
        });
      })();
    </script>
  </head>

  <body>
    <Header />

    <div class={`layout-grid ${isLanding ? 'landing-mode' : ''}`}>
      <aside class="sticky-panel left-panel hide-on-mobile">
        <LeftSidebar headings={headings} />
      </aside>

      <main class="main-content" data-pagefind-body>
        <div class="content-wrapper">
          <slot />
        </div>
      </main>

      <aside class="sticky-panel right-panel hide-on-tablet">
        <RightSidebar frontmatter={frontmatter} docId={docId} />
      </aside>
    </div>

    <!-- BOTÓN COPIAR CÓDIGO -->
    <script>
      document.addEventListener('astro:page-load', () => {
        document.querySelectorAll('.main-content pre').forEach((preNode) => {
          const pre = preNode as HTMLElement;
          const isMermaid = pre.getAttribute('data-language') === 'mermaid' || !!pre.querySelector('.language-mermaid');
          if (isMermaid || pre.querySelector('.copy-code-btn')) return;

          const btn = document.createElement('button');
          btn.className = 'copy-code-btn';
          btn.innerText = 'Copiar';

          btn.addEventListener('click', async () => {
            const codeEl = pre.querySelector('code');
            const code = codeEl ? codeEl.textContent : pre.textContent;
            if (!code) return;

            try {
              await navigator.clipboard.writeText(code);
              btn.innerText = '¡Copiado!';
              btn.classList.add('copied');
              setTimeout(() => {
                btn.innerText = 'Copiar';
                btn.classList.remove('copied');
              }, 2000);
            } catch (error) {
              console.error('Error al copiar:', error);
            }
          });

          pre.appendChild(btn);
        });
      });
    </script>

<!-- MERMAID CON RE-RENDERIZADO REACTIVO -->
    <script>
      import mermaid, { type MermaidConfig } from 'mermaid';

      function getMermaidConfig(): MermaidConfig {
        const isDark = document.documentElement.getAttribute('data-modo') === 'oscuro';
        return {
          startOnLoad: false,
          look: 'classic',
          theme: isDark ? 'dark' : 'default',
          themeVariables: {
            background: 'transparent',
            fontFamily: 'system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
            fontSize: '14px',
            primaryColor: isDark ? '#1e293b' : '#f1f5f9',
            primaryTextColor: isDark ? '#f8fafc' : '#0f172a',
            primaryBorderColor: isDark ? '#38bdf8' : '#6366f1',
            lineColor: isDark ? '#94a3b8' : '#64748b',
            textColor: isDark ? '#f8fafc' : '#0f172a',
            actorTextColor: isDark ? '#f8fafc' : '#0f172a',
            actorLineColor: isDark ? '#38bdf8' : '#6366f1',
            signalColor: isDark ? '#f8fafc' : '#0f172a',
            signalTextColor: isDark ? '#f8fafc' : '#0f172a',
            labelBoxBkgColor: isDark ? '#1e293b' : '#f8fafc',
            labelBoxBorderColor: isDark ? '#38bdf8' : '#6366f1',
            labelTextColor: isDark ? '#f8fafc' : '#0f172a',
            loopTextColor: isDark ? '#f8fafc' : '#0f172a',
            noteBorderColor: isDark ? '#f59e0b' : '#d97706',
            noteBkgColor: isDark ? '#78350f' : '#fef3c7',
            noteTextColor: isDark ? '#fef3c7' : '#78350f',
            taskBorderColor: isDark ? '#38bdf8' : '#6366f1',
            taskBkgColor: isDark ? '#1e293b' : '#e2e8f0',
            taskTextColor: isDark ? '#f8fafc' : '#0f172a',
            taskTextOutsideColor: isDark ? '#f8fafc' : '#0f172a',
            activeTaskBorderColor: isDark ? '#818cf8' : '#4f46e5',
            activeTaskBkgColor: isDark ? '#312e81' : '#c7d2fe',
            gridColor: isDark ? '#334155' : '#cbd5e1',
            sectionBkgColor: isDark ? 'rgba(255,255,255,0.02)' : 'rgba(0,0,0,0.02)',
            altSectionBkgColor: isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.04)'
          },
          flowchart: {
            htmlLabels: true,
            padding: 10,
            nodeSpacing: 35,
            rankSpacing: 35,
            curve: 'linear'
          },
          gantt: {
            useWidth: 1500,
            useMaxWidth: false,
            leftPadding: 160,
            barHeight: 28,
            barGap: 8,
            topPadding: 50,
            titleTopMargin: 25,
            gridLineStartPadding: 35,
            fontSize: 12,
            sectionFontSize: 14,
            numberSectionStyles: 4,
            axisFormat: '%d/%m'
          }
        };
      }

      async function renderMermaid(forceReRender = false) {
        // 1. Registrar bloques originales
        const codeBlocks = Array.from(
          document.querySelectorAll('pre[data-language="mermaid"], pre:has(code.language-mermaid)')
        );

        codeBlocks.forEach((preNode) => {
          const pre = preNode as HTMLElement;
          if (pre.dataset.mermaidRegistered === 'true') return;

          const codeEl = pre.querySelector('code');
          const rawCode = (codeEl?.textContent || pre.textContent || '').trim();
          if (!rawCode) return;

          const container = document.createElement('div');
          container.className = 'mermaid-native';
          container.dataset.sourceCode = rawCode;

          pre.after(container);
          pre.style.display = 'none';
          pre.dataset.mermaidRegistered = 'true';
        });

        mermaid.initialize(getMermaidConfig());

        const containers = Array.from(document.querySelectorAll<HTMLElement>('.mermaid-native'));
        const standardNodes: HTMLElement[] = [];

        for (const [index, container] of containers.entries()) {
          const code = container.dataset.sourceCode;
          if (!code) continue;

          if (container.dataset.renderedMode && !forceReRender) continue;

          const cleanCode = code.replace(/%%[\s\S]*?%%/g, '').trim();
          const isGantt = cleanCode.startsWith('gantt');

          if (isGantt) {
            container.className = 'mermaid-native is-gantt';
            const renderId = `mermaid-gantt-${Date.now()}-${index}`;

            // 1. Detectar si pusiste %%width: 750%% o %%width: 1400%%
            const widthMatch = code.match(/%%width:\s*(\d+)(?:px)?%%/i);
            const customWidth = widthMatch ? parseInt(widthMatch[1], 10) : 1000;

            // 2. Limpiar la directiva %%width%%
            let cleanGanttCode = code.replace(/%%width:\s*(\d+)(?:px)?%%/i, '').trim();

            // 3. Inyectar directiva oficial interna
            cleanGanttCode = `%%{init: { 'gantt': { 'useWidth': ${customWidth} } } }%%\n` + cleanGanttCode;

            try {
              const { svg } = await mermaid.render(renderId, cleanGanttCode);
              container.innerHTML = svg;

              const svgEl = container.querySelector('svg');
              if (svgEl) {
                // Forzar el ancho específico de este diagrama
                svgEl.style.setProperty('width', `${customWidth}px`, 'important');
                svgEl.style.setProperty('min-width', `${customWidth}px`, 'important');
                svgEl.style.maxWidth = 'none';
                svgEl.style.height = 'auto';
              }
              container.dataset.renderedMode = document.documentElement.getAttribute('data-modo') || 'oscuro';
            } catch (err) {
              console.error('Error renderizando Gantt:', err);
            }
          } else {
            // Para evitar que se lea el texto en crudo, ocultamos el contenedor mientras se computa
            container.className = 'mermaid-native';
            container.style.visibility = 'hidden'; 
            container.textContent = code;
            container.removeAttribute('data-processed');
            standardNodes.push(container);
          }
        }

        if (standardNodes.length > 0) {
          try {
            await mermaid.run({ nodes: standardNodes });
            const currentMode = document.documentElement.getAttribute('data-modo') || 'oscuro';
            standardNodes.forEach((node) => {
              node.style.visibility = 'visible'; // Se vuelve a mostrar ya dibujado
              node.dataset.renderedMode = currentMode;
            });
          } catch (error) {
            console.error('Error en mermaid.run():', error);
          }
        }
      }

      // Escuchar carga de página
      document.addEventListener('astro:page-load', () => renderMermaid(false));
      // En src/layouts/Base.astro
      let themeTimeout: ReturnType<typeof setTimeout>;

      // Observador de mutación para re-renderizar inmediatamente al cambiar el tema (claro/oscuro)
      const observer = new MutationObserver((mutations) => {
        for (const mutation of mutations) {
          if (mutation.type === 'attributes' && mutation.attributeName === 'data-modo') {
            clearTimeout(themeTimeout);
            // Espera 100ms para asegurar que el CSS de la página ya cambió antes de pintar Mermaid
            themeTimeout = setTimeout(() => {
              renderMermaid(true);
            }, 100);
          }
        }
      });

      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-modo']
      });
    </script>
  </body>
</html>