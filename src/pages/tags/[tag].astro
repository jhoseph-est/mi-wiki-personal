---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const allDocs = await getCollection('docs');
  
  // Extraer todos los tags únicos
  const uniqueTags = [...new Set(allDocs.map((doc: any) => doc.data.tags || []).flat())];

  return uniqueTags.map((tag) => {
    const filteredDocs = allDocs.filter((doc: any) => 
      doc.data.tags?.includes(tag)
    );
    return {
      params: { tag },
      props: { docs: filteredDocs },
    };
  });
}

const { tag } = Astro.params;
const { docs } = Astro.props;
---

<Base title={`Etiqueta: ${tag}`}>
  <div class="tag-header">
    <h1>Documentos etiquetados con: <span>#{tag}</span></h1>
    <p>Se encontraron {docs.length} apuntes.</p>
  </div>

  <ul class="tag-list">
    {docs.map((doc: any) => (
      <li>
        <a href={`/docs/${doc.id}`} class="tag-link">
          <h2>{doc.data.title}</h2>
          <span class="folder-badge">📁 {doc.id.split('/').slice(0, -1).join('/') || 'Raíz'}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
.tag-header { margin-bottom: 2rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1rem; }
  .tag-header span { color: #8b5cf6; }
  .tag-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  
  .tag-link {
    display: flex; align-items: center; gap: 15px; padding: 0.8rem 1rem;
    background: transparent; border-bottom: 1px solid rgba(0,0,0,0.05);
    text-decoration: none; color: var(--text-color); transition: background 0.2s ease;
  }
  .tag-link:hover { background: rgba(0,0,0,0.02); }
  .tag-link h2 { margin: 0; font-size: 1.05rem; font-weight: 500; flex-grow: 1; }
  .folder-badge { font-size: 0.75rem; opacity: 0.6; }
</style>