---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada">
  <div style="text-align: center; padding: 10vh 2rem; display: flex; flex-direction: column; align-items: center;">
    <span style="font-size: 5rem; display: block; margin-bottom: 1rem;">🕳️</span>
    <h1 style="font-size: 3rem; margin: 0; color: var(--text-color);">Error 404</h1>
    <p style="font-size: 1.2rem; opacity: 0.7; max-width: 500px;">
      El apunte o directorio que buscas no existe, fue renombrado o ha sido movido a otra carpeta.
    </p>
    <a href="/docs/explorar" class="action-btn" style="margin-top: 2rem; font-size: 1.1rem; padding: 0.8rem 1.5rem;">
      Volver al Explorador
    </a>
  </div>
</Base>