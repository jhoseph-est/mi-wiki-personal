<header class="main-header">
  <!-- 1. MENÚ HAMBURGUESA (Solo en celular) -->
  <button id="btn-mobile-menu" class="icon-btn hide-on-desktop">
    <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <line x1="3" y1="12" x2="21" y2="12"></line>
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
  </button>

  <!-- 2. LOGO (Botón de Inicio) -->
  <a href="/" class="logo-container">
    <span class="site-logo" style="font-size: 24px;">📚</span>
    <span class="site-title hide-on-mobile">Mi Repositorio</span>
  </a>

  <!-- 3. BUSCADOR -->
  <div class="search-container">
    <input type="text" id="search-input" class="search-bar" placeholder="Buscar (Cmd+K)..." autocomplete="off" />
    <div id="search-backdrop" class="search-backdrop"></div>
    <ul id="search-results" class="search-results"></ul>
  </div>

  <!-- 4. ENGRANAJE (Panel Derecho) -->
  <button id="toggle-settings-btn" class="icon-btn hide-on-desktop" title="Configuración">
    <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="3"></circle>
      <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
    </svg>
  </button>
</header>

<script>
  function initHeader() {
    let searchData: any[] = [];
    const input = document.getElementById('search-input') as HTMLInputElement;
    const resultsBox = document.getElementById('search-results');
    const backdrop = document.getElementById('search-backdrop');

    // --- LÓGICA DE BÚSQUEDA ---
    const newHandler = async (e: Event) => {
      const rawQuery = (e.target as HTMLInputElement).value.toLowerCase();
      
      if (rawQuery.length < 2) {
        if (resultsBox) resultsBox.style.display = 'none';
        if (backdrop) backdrop.style.display = 'none';
        return;
      }

      if (searchData.length === 0) {
        const res = await fetch('/search.json');
        searchData = await res.json();
      }

      const isTagSearch = rawQuery.startsWith('#');
      const query = isTagSearch ? rawQuery.slice(1).trim() : rawQuery;

      const filtered = searchData.filter(item => {
        const tagMatch = item.tags.some((tag: string) => tag.toLowerCase().includes(query));
        if (isTagSearch) return tagMatch;
        return item.title.toLowerCase().includes(query) || tagMatch;
      });

      if (resultsBox && backdrop) {
        resultsBox.innerHTML = '';
        if (filtered.length > 0) {
          filtered.forEach(item => {
            const li = document.createElement('li');
            li.innerHTML = `<a href="${item.url}">📄 <span class="text-truncate" style="display:inline-block; max-width:80%; vertical-align:middle;">${item.title}</span> ${item.tags.length > 0 ? `<small style="opacity:0.5">(${item.tags.join(', ')})</small>` : ''}</a>`;
            resultsBox.appendChild(li);
          });
        } else {
          resultsBox.innerHTML = '<li class="no-results">No se encontraron resultados</li>';
        }
        resultsBox.style.display = 'block';
        backdrop.style.display = 'block';
      }
    };

    if (input) {
      input.replaceWith(input.cloneNode(true));
      const freshInput = document.getElementById('search-input') as HTMLInputElement;
      freshInput?.addEventListener('input', newHandler);
    }

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (resultsBox && backdrop && !target.closest('.search-container') && !target.closest('.search-results')) {
        resultsBox.style.display = 'none';
        backdrop.style.display = 'none';
      }
    });

    // --- MENÚ MÓVIL IZQUIERDO ---
    const btnMobileMenu = document.getElementById('btn-mobile-menu');
    if (btnMobileMenu) {
      btnMobileMenu.replaceWith(btnMobileMenu.cloneNode(true));
      const freshBtnMobile = document.getElementById('btn-mobile-menu');
      freshBtnMobile?.addEventListener('click', () => {
        const leftPanel = document.querySelector('.left-panel');
        leftPanel?.classList.toggle('show-mobile-menu');
        // Cerrar el derecho si estaba abierto
        document.querySelector('.right-panel')?.classList.remove('show-mobile-right');
      });
    }

    // --- MENÚ MÓVIL DERECHO (ENGRANAJE) ---
    const settingsBtn = document.getElementById('toggle-settings-btn');
    if (settingsBtn) {
      settingsBtn.replaceWith(settingsBtn.cloneNode(true));
      const freshSettingsBtn = document.getElementById('toggle-settings-btn');
      freshSettingsBtn?.addEventListener('click', () => {
        const rightPanel = document.querySelector('.right-panel');
        rightPanel?.classList.toggle('show-mobile-right');
        // Cerrar el izquierdo si estaba abierto
        document.querySelector('.left-panel')?.classList.remove('show-mobile-menu');
      });
    }

    // --- ATAJOS DE TECLADO ---
    document.addEventListener('keydown', (e) => {
      const searchInput = document.getElementById('search-input') as HTMLInputElement;
      const resultsBox = document.getElementById('search-results');
      const backdrop = document.getElementById('search-backdrop');

      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        if (searchInput) searchInput.focus();
      }

      if (e.key === 'Escape') {
        if (resultsBox && backdrop) {
          resultsBox.style.display = 'none';
          backdrop.style.display = 'none';
        }
        if (searchInput) searchInput.blur();
      }
    });
  }

  document.addEventListener('astro:page-load', initHeader);
</script>