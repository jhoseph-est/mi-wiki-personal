---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allDocs = await getCollection('docs');
  const slideDocs = allDocs.filter((doc: any) => doc.data.slides === true);
  return slideDocs.map((doc: any) => ({
    params: { id: doc.id.replace(/\\/g, '/') },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const docUrl = `/docs/${doc.id.replace(/\\/g, '/')}`;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Presentación: {doc.data.title}</title>
  
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/reveal.js@4.6.1/dist/reveal.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/reveal.js@4.6.1/dist/theme/black.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/reveal.js@4.6.1/plugin/highlight/monokai.css">
  
  <style>
    .reveal h1, .reveal h2, .reveal h3 { text-transform: none; color: #a78bfa; font-weight: bold; }
    .reveal p, .reveal li { font-size: 1.2em; line-height: 1.6; }
    .reveal pre { width: 100%; max-height: 65vh; margin: 20px auto; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4); border-radius: 8px; }
    .reveal pre code { max-height: 65vh !important; overflow-y: auto !important; padding: 20px; }
    .btn-exit {
      position: fixed; top: 20px; left: 20px; z-index: 9999;
      background: rgba(255, 255, 255, 0.1); color: white;
      border: 1px solid rgba(255, 255, 255, 0.2); padding: 10px 20px;
      border-radius: 8px; cursor: pointer; font-size: 0.9rem;
      font-family: system-ui, sans-serif; text-decoration: none;
      backdrop-filter: blur(5px); transition: all 0.2s ease;
    }
    .btn-exit:hover { background: #ef4444; border-color: #ef4444; }
  </style>
</head>
<body>

  <!-- Botón para cerrar la pestaña y volver -->
  <a href="#" onclick="window.close()" class="btn-exit">✖ Cerrar</a>

  <div class="reveal">
    <div class="slides">
      <section data-markdown data-separator="^\n---\n$" data-separator-vertical="^\n--\n$">
        <textarea data-template>{doc.body}</textarea>
      </section>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/reveal.js@4.6.1/dist/reveal.js" is:inline></script>
  <script src="https://cdn.jsdelivr.net/npm/reveal.js@4.6.1/plugin/markdown/markdown.js" is:inline></script>
  <script src="https://cdn.jsdelivr.net/npm/reveal.js@4.6.1/plugin/highlight/highlight.js" is:inline></script>
  <script src="https://cdn.jsdelivr.net/npm/reveal.js@4.6.1/plugin/math/math.js" is:inline></script>
  <script src="https://cdn.jsdelivr.net/npm/reveal.js@4.6.1/plugin/notes/notes.js" is:inline></script>

  <script is:inline>
    // Inicialización nativa y limpia
    Reveal.initialize({
      controls: true,
      progress: true,
      center: true,
      hash: true,
      transition: 'slide',
      plugins: [ RevealMarkdown, RevealHighlight, RevealMath.KaTeX, RevealNotes ]
    });

    // Cerrar ventana con Q
    document.addEventListener('keydown', (e) => {
      if (e.key.toLowerCase() === 'q') window.close();
    });
  </script>
</body>
</html>