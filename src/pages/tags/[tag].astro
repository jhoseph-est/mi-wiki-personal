---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatName } from '../../utils/fileTree';

export async function getStaticPaths() {
  const allDocs = await getCollection('docs');
  
  // 1. Descartamos borradores de raíz
  const publishedDocs = allDocs.filter((doc: CollectionEntry<'docs'>) => doc.data.draft !== true);

  // 2. Extraer etiquetas únicas solo de apuntes publicados
  const uniqueTags = [...new Set(publishedDocs.flatMap((doc) => doc.data.tags || []))];

  return uniqueTags.map((tag) => {
    const filteredDocs = publishedDocs.filter((doc) => doc.data.tags?.includes(tag));
    return {
      params: { tag },
      props: { docs: filteredDocs },
    };
  });
}

interface Props {
  docs: CollectionEntry<'docs'>[];
}

const { tag } = Astro.params;
const { docs } = Astro.props;
---

<Base title={`Etiqueta: #${tag}`}>
  <div class="tag-header">
    <h1>Documentos etiquetados con: <span>#{tag}</span></h1>
    <p>Se encontraron {docs.length} {docs.length === 1 ? 'apunte' : 'apuntes'}.</p>
  </div>

  <ul class="tag-list">
    {docs.map((doc) => {
      const normalizedId = doc.id.replace(/\\/g, '/');
      const folderPath = normalizedId.split('/').slice(0, -1).join(' / ');
      
      return (
        <li>
          <a href={`/docs/${normalizedId}`} class="tag-link">
            <h2>{doc.data.title}</h2>
            <span class="folder-badge">📁 {folderPath ? formatName(folderPath) : 'Raíz'}</span>
          </a>
        </li>
      );
    })}
  </ul>
</Base>

<style>
  .tag-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1rem;
  }
  .tag-header h1 {
    margin: 0 0 0.5rem 0;
    color: var(--text-color);
    font-size: 1.8rem;
  }
  .tag-header span {
    color: #8b5cf6;
  }
  .tag-header p {
    margin: 0;
    opacity: 0.7;
    font-size: 0.95rem;
  }
  
  .tag-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .tag-link {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 0.8rem 1rem;
    background: rgba(0, 0, 0, 0.02);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    text-decoration: none;
    color: var(--text-color);
    transition: all 0.2s ease;
  }
  .tag-link:hover {
    background: rgba(139, 92, 246, 0.08);
    border-color: #8b5cf6;
    transform: translateX(4px);
  }
  .tag-link h2 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 500;
    flex-grow: 1;
  }
  .folder-badge {
    font-size: 0.8rem;
    opacity: 0.6;
    white-space: nowrap;
  }
</style>