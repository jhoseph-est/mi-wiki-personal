---
// src/components/GraphModal.astro
---
<div id="graph-modal" class="graph-modal-overlay">
  <div class="graph-modal-content">
    <div class="graph-modal-header">
      <div>
        <h3 style="margin: 0; color: #8b5cf6;">Red de Conocimiento</h3>
        <p style="margin: 0; opacity: 0.7; font-size: 0.9rem;">Haz clic en un nodo para navegar a ese apunte.</p>
      </div>
      <button id="close-graph-btn" class="close-btn">
        Cerrar
      </button>
    </div>
    <div id="graph-container"></div>
  </div>
</div>

<style>
  .graph-modal-overlay {
    position: fixed; inset: 0; background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(5px); z-index: 9999; display: flex;
    justify-content: center; align-items: center; opacity: 0;
    pointer-events: none; transition: opacity 0.2s ease;
  }
  .graph-modal-overlay.active { opacity: 1; pointer-events: auto; }
  .graph-modal-content {
    width: 95vw; height: 90vh; background: var(--bg-color);
    border: 1px solid var(--border-color); border-radius: 12px;
    display: flex; flex-direction: column;
    box-shadow: 0 25px 50px rgba(0,0,0,0.5); overflow: hidden;
  }
  .graph-modal-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 1rem 1.5rem; border-bottom: 1px solid var(--border-color);
    background: var(--header-bg);
  }
  #graph-container { flex-grow: 1; width: 100%; height: 100%; cursor: grab; position: relative; }
  #graph-container:active { cursor: grabbing; }
  
  .close-btn {
    background: rgba(239, 68, 68, 0.1); color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.3); padding: 0.4rem 0.8rem;
    border-radius: 6px; cursor: pointer; font-weight: bold;
    font-size: 0.85rem; transition: all 0.2s ease;
  }
  .close-btn:hover { background: #ef4444; color: white; }
</style>

<script>
  import ForceGraph from 'force-graph';

  function setupGraphModal() {
    const btnToggleGraph = document.getElementById('btn-toggle-graph');
    const graphModal = document.getElementById('graph-modal');
    const closeGraphBtn = document.getElementById('close-graph-btn');
    const graphContainer = document.getElementById('graph-container');
    
    if (!btnToggleGraph || !graphModal || !graphContainer) return;

    let Graph: any = null;
    let isFetching = false;

    const closeGraphModal = () => {
      graphModal.classList.remove('active');
      if (Graph) {
        Graph._destructor && Graph._destructor();
        Graph = null;
      }
      graphContainer.innerHTML = '';
    };

    const openGraphModal = () => {
      graphModal.classList.add('active');
      if (Graph || isFetching) return;

      isFetching = true;
      graphContainer.innerHTML = '';

      fetch('/api/graph.json')
        .then(res => res.json())
        .then(data => {
          isFetching = false;
          if (!graphModal.classList.contains('active')) return;

          const isDark = document.documentElement.getAttribute('data-modo') === 'oscuro';
          const bgColor = isDark ? 'var(--bg-color)' : '#ffffff';
          const lineColor = isDark ? 'rgba(255,255,255,255)' : 'rgba(0,255,0,255)';
          const textColor = isDark ? 'rgba(255,255,255,0.9)' : 'rgba(0,0,0,0.9)';

          // @ts-ignore
          Graph = ForceGraph()(graphContainer)
            .graphData(data)
            .nodeAutoColorBy('group')
            .nodeLabel(() => '') // <-- ESTO DESACTIVA EL TOOLTIP NATIVO FLOTANTE
            .linkColor(() => lineColor)
            .linkWidth(2.5)
            .backgroundColor(bgColor)
            .nodeCanvasObject((node: any, ctx: any, globalScale: number) => {
              const nodeSize = 4;
              
              ctx.beginPath();
              ctx.arc(node.x, node.y, nodeSize, 0, 2 * Math.PI, false);
              ctx.fillStyle = node.color || '#8b5cf6';
              ctx.fill();

              if (globalScale >= 1.2) {
                const fontSize = 12 / globalScale;
                ctx.font = `${fontSize}px system-ui, sans-serif`;
                ctx.textAlign = 'center';
                ctx.textBaseline = 'top';
                ctx.fillStyle = textColor;
                ctx.fillText(node.name, node.x, node.y + nodeSize + (2 / globalScale));
              }
            })
            .onNodeClick((node: any) => {
              if (node && node.id) window.location.href = node.id;
            });
            
          setTimeout(() => {
            if (graphContainer) {
              Graph.width(graphContainer.clientWidth);
              Graph.height(graphContainer.clientHeight);
              Graph.zoomToFit(400, 40);
            }
          }, 50);
        })
        .catch(() => { isFetching = false; });
    };

    btnToggleGraph.onclick = openGraphModal;
    if (closeGraphBtn) closeGraphBtn.onclick = closeGraphModal;
  }

  document.addEventListener('astro:page-load', setupGraphModal);
</script>