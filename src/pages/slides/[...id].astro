---
import { getCollection, type CollectionEntry } from 'astro:content';

// 1. Estilos encapsulados de Reveal.js
import 'reveal.js/reveal.css';
import 'reveal.js/theme/black.css';
import 'reveal.js/plugin/highlight/monokai.css';

export async function getStaticPaths() {
  const allDocs = await getCollection('docs');
  // Filtramos borradores y tomamos solo los que tienen slides: true
  const slideDocs = allDocs.filter(
    (doc: CollectionEntry<'docs'>) => doc.data.draft !== true && doc.data.slides === true
  );

  return slideDocs.map((doc) => ({
    params: { id: doc.id.replace(/\\/g, '/') },
    props: { doc },
  }));
}

interface Props {
  doc: CollectionEntry<'docs'>;
}

const { doc } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Presentación: {doc.data.title}</title>
  
  <style>
    .reveal h1, .reveal h2, .reveal h3 { text-transform: none; color: #a78bfa; font-weight: bold; }
    .reveal p, .reveal li { font-size: 1.2em; line-height: 1.6; }
    .reveal pre { width: 100%; max-height: 65vh; margin: 20px auto; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4); border-radius: 8px; }
    .reveal pre code { max-height: 65vh !important; overflow-y: auto !important; padding: 20px; }
    .btn-exit {
      position: fixed; top: 20px; left: 20px; z-index: 9999;
      background: rgba(255, 255, 255, 0.1); color: white;
      border: 1px solid rgba(255, 255, 255, 0.2); padding: 10px 20px;
      border-radius: 8px; cursor: pointer; font-size: 0.9rem;
      font-family: system-ui, sans-serif; text-decoration: none;
      backdrop-filter: blur(5px); transition: all 0.2s ease;
    }
    .btn-exit:hover { background: #ef4444; border-color: #ef4444; }
  </style>
</head>
<body>
  <a href="#" onclick="window.close()" class="btn-exit" aria-label="Cerrar presentación">✕ Cerrar</a>
  
  <div class="reveal">
    <div class="slides">
      <section data-markdown data-separator="^\n---\n$" data-separator-vertical="^\n--\n$">
        <textarea data-template>{doc.body}</textarea>
      </section>
    </div>
  </div>

  <script>
    import Reveal from 'reveal.js';
    import Markdown from 'reveal.js/plugin/markdown';
    import Highlight from 'reveal.js/plugin/highlight';
    import RevealMath from 'reveal.js/plugin/math';
    import Notes from 'reveal.js/plugin/notes';

    const deck = new Reveal({
      controls: true,
      progress: true,
      center: true,
      hash: true,
      transition: 'slide',
      // Cambiamos KaTeX por MathJax3 nativo de Reveal.js
      plugins: [ Markdown, Highlight, RevealMath.MathJax3, Notes ]
    });

    deck.initialize();

    document.addEventListener('keydown', (e) => {
      if (e.key.toLowerCase() === 'q') window.close();
    });
  </script>
</body>
</html>