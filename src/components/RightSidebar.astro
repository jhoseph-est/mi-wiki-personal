---
// Recibimos los datos del layout
const { frontmatter = {} } = Astro.props;

// Pequeña función para que la fecha se vea bonita (ej: 3 de septiembre de 2026)
const formatDate = (dateStr: Date | string) => {
  if (!dateStr) return '';
  const date = new Date(dateStr);
  return date.toLocaleDateString('es-ES', {
    year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC'
  });
};
---

<div class="right-sidebar-content">
  <h3 class="panel-title">Metadatos</h3>

  <!-- Ficha de Fecha -->
  {frontmatter.date && (
    <div class="ficha">
      <span class="ficha-label">📅 Fecha</span>
      <span class="ficha-value">{formatDate(frontmatter.date)}</span>
    </div>
  )}

  <!-- Ficha de Autor -->
  {frontmatter.author && (
    <div class="ficha">
      <span class="ficha-label">✍️ Autor</span>
      <span class="ficha-value">{frontmatter.author}</span>
    </div>
  )}

  <!-- Ficha de Etiquetas (Tags) -->
  {frontmatter.tags && frontmatter.tags.length > 0 && (
    <div class="ficha">
      <span class="ficha-label">🏷️ Etiquetas</span>
      <div class="tags-container">
        {frontmatter.tags.map((tag: string) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </div>
  )}

  <!-- Mensaje por si no hay datos -->
  {(!frontmatter.date && !frontmatter.author && !frontmatter.tags) && (
    <p class="empty-msg">No hay metadatos adicionales para este documento.</p>
  )}
</div>

<style>
  .right-sidebar-content { display: flex; flex-direction: column; gap: 1rem; }
  .panel-title { font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; opacity: 0.7; margin-bottom: 0.5rem; }
  
  .ficha {
    background: rgba(0,0,0,0.03);
    padding: 1rem;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    border: 1px solid var(--border-color);
  }
  .ficha-label { font-size: 0.8rem; font-weight: bold; opacity: 0.8; }
  .ficha-value { font-size: 0.9rem; color: var(--text-color); }
  
  .tags-container { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.3rem; }
  .tag {
    background: var(--text-color);
    color: var(--bg-color);
    padding: 0.2rem 0.7rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: lowercase;
  }
  .empty-msg { font-size: 0.85rem; font-style: italic; opacity: 0.6; }
</style>