---
import '../styles/base.css';
import Header from '../components/Header.astro';
import LeftSidebar from '../components/LeftSidebar.astro';
import RightSidebar from '../components/RightSidebar.astro';
import { ClientRouter } from 'astro:transitions';

const { title, headings = [], frontmatter = {}, docId, isLanding = false } = Astro.props;
const estiloDoc = frontmatter.theme || 'moderno';
---
<!DOCTYPE html>
<html lang="es" data-estilo={estiloDoc}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} | Repositorio Personal</title>
    <ClientRouter />
    <script is:inline>
      (function() {
        const html = document.documentElement;
        const body = document.body;

        const modo = localStorage.getItem('pref-modo') || 'oscuro';
        const texto = localStorage.getItem('pref-texto') || 'estandar';
        const ancho = localStorage.getItem('pref-ancho') || 'normal';

        html.setAttribute('data-modo', modo);
        html.setAttribute('data-texto', texto);
        html.setAttribute('data-ancho', ancho);

        if (body) {
          body.setAttribute('data-modo', modo);
        }

        document.addEventListener('astro:before-swap', (ev) => {
          const m = localStorage.getItem('pref-modo') || 'oscuro';
          const t = localStorage.getItem('pref-texto') || 'estandar';
          const a = localStorage.getItem('pref-ancho') || 'normal';
          
          const nuevoEstilo = ev.newDocument.documentElement.getAttribute('data-estilo') || 'moderno';

          ev.newDocument.documentElement.setAttribute('data-modo', m);
          ev.newDocument.documentElement.setAttribute('data-estilo', nuevoEstilo);
          ev.newDocument.documentElement.setAttribute('data-texto', t);
          ev.newDocument.documentElement.setAttribute('data-ancho', a);

          if (ev.newDocument.body) {
            ev.newDocument.body.setAttribute('data-modo', m);
          }
        });
      })();
    </script>
  </head>
  <body>
    <Header />
    
    <!-- ESTA ES LA ESTRUCTURA CORREGIDA (Sin duplicados) -->
   <!-- ESTA ES LA ESTRUCTURA CORREGIDA -->
    <div class={`layout-grid ${isLanding ? 'landing-mode' : ''}`}>
      
      <aside class="sticky-panel left-panel hide-on-mobile">
        <LeftSidebar headings={headings} />
      </aside>

      <main class="main-content">
        <div class="content-wrapper">
          <slot />
        </div>
      </main>

      <aside class="sticky-panel right-panel hide-on-tablet">
        <RightSidebar frontmatter={frontmatter} docId={docId} />
      </aside>
      
    </div>



    <!-- Script de Botón Copiar -->
    <script>
      document.addEventListener('astro:page-load', () => {
        const preElements = document.querySelectorAll('.main-content pre');
        
        preElements.forEach((preNode) => {
          const pre = preNode as HTMLElement; 
          
          if (pre.querySelector('.copy-code-btn')) return;
          
          const btn = document.createElement('button');
          btn.className = 'copy-code-btn';
          btn.innerText = 'Copiar';
          
          btn.addEventListener('click', async () => {
            const codeElement = pre.querySelector('code') as HTMLElement | null;
            const code = codeElement ? codeElement.textContent : pre.textContent;
            
            if (code) {
              await navigator.clipboard.writeText(code);
              
              btn.innerText = '¡Copiado!';
              btn.classList.add('copied');
              
              setTimeout(() => {
                btn.innerText = 'Copiar';
                btn.classList.remove('copied');
              }, 2000);
            }
          });
          
          pre.appendChild(btn);
        });
      });
    </script>
<script src="/mermaid.min.js" is:inline></script>
<script is:inline>
  document.addEventListener('astro:page-load', async () => {
    const mermaidCodes = document.querySelectorAll('pre[data-language="mermaid"] code, pre code.language-mermaid');
    
    if (mermaidCodes.length === 0) return;
    
    const currentMode = document.documentElement.getAttribute('data-modo') === 'oscuro' ? 'dark' : 'default';
    mermaid.initialize({ startOnLoad: false, theme: currentMode });
    
    mermaidCodes.forEach(async (codeBlock, i) => {
      const pre = codeBlock.closest('pre');
      const graphCode = codeBlock.textContent;
      
      const container = document.createElement('div');
      container.className = 'mermaid-dynamic-container';
      container.style.textAlign = 'center';
      container.style.margin = '2rem 0';
      
      if (pre) pre.replaceWith(container);
      
      try {
        const uniqueId = `mermaid-svg-${i}-${Date.now()}`;
        const { svg } = await mermaid.render(uniqueId, graphCode);
        container.innerHTML = svg;
      } catch (error) {
        console.error("Error al renderizar Mermaid:", error);
      }
    });
  });
</script>
  </body>
</html>