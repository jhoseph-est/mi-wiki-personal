---
import '../styles/base.css';
import 'katex/dist/katex.min.css';
import Header from '../components/Header.astro';
import LeftSidebar from '../components/LeftSidebar.astro';
import RightSidebar from '../components/RightSidebar.astro';
import { ClientRouter } from 'astro:transitions'; // <-- IMPORTANTE

const { title, headings = [], frontmatter = {} } = Astro.props;
---
<!DOCTYPE html>
<html lang="es" data-tema-forzado={frontmatter.theme}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} | Repositorio Personal</title>
    <ClientRouter /> <!-- <-- Mantiene el layout fijo sin recargas bruscas -->
    
    <script is:inline>
      const html = document.documentElement;
      const temaForzado = html.getAttribute('data-tema-forzado');
      const prefs = ['modo', 'estilo', 'texto', 'ancho'];
      prefs.forEach(id => {
        if (id === 'estilo' && temaForzado) {
          html.setAttribute('data-estilo', temaForzado);
          return;
        }
        const guardado = localStorage.getItem(`pref-${id}`);
        if (guardado) html.setAttribute(`data-${id}`, guardado);
      });
    </script>
  </head>
  <body>
    <Header />
    <div class="layout-grid">
      <aside class="sticky-panel left-panel hide-on-mobile">
        <LeftSidebar headings={headings} />
      </aside>
      <main class="main-content">
        <slot />
      </main>
      <aside class="sticky-panel right-panel hide-on-tablet">
        <RightSidebar frontmatter={frontmatter} />
      </aside>
    </div>
  </body>
</html>