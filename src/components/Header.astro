---
---
<!-- Fondo oscuro al buscar -->
<div id="search-backdrop" class="search-backdrop"></div> 
<header class="main-header">   
  <div class="header-left">     
    <button id="btn-mobile-menu" class="icon-btn hide-on-desktop">☰</button>     
    <a href="/" class="logo-container">
      <span class="logo-icon">📚</span>
      <span class="logo-text">Mi Repositorio</span>
    </a>
  </div>   

  <div class="header-center">     
    <nav class="nav-links hide-on-mobile">       
      <a href="/" class="nav-pill">🏠 Inicio</a>       
      <a href="/docs/portada" class="nav-pill">📘 Portada</a>       
      <a href="#" id="btn-random" class="nav-pill">🎲 Aleatorio</a>     
    </nav>   </div>   

  <div class="header-right">     
    <div class="search-container">       
      <input type="text" id="search-input" placeholder="Buscar... (Usa # para tags)" class="search-bar" autocomplete="off" />     </div>     
    <button id="btn-settings" class="icon-btn" title="Apariencia">⚙️</button>   </div> 
</header> 
<ul id="search-results" class="search-results"></ul> 

<style>   
  .main-header { 
    position: sticky; top: 0; height: var(--header-height); background: var(--header-bg); 
    border-bottom: 1px solid var(--border-color); display: flex; align-items: center; 
    justify-content: space-between; padding: 0 1.5rem; z-index: 100; 
  }   
  .header-left, .header-center, .header-right { display: flex; align-items: center; gap: 1rem; }   
  .header-center { flex-grow: 1; justify-content: center; }   
  
  .logo-container { display: flex; align-items: center; gap: 0.5rem; text-decoration: none; color: var(--text-color); font-weight: bold; font-size: 1.1rem; }
  
  .nav-links { display: flex; gap: 0.5rem; }
  .nav-pill { color: var(--text-color); text-decoration: none; font-weight: 500; font-size: 0.85rem; padding: 0.4rem 0.8rem; border-radius: 6px; background: rgba(0,0,0,0.03); transition: background 0.15s; }
  .nav-pill:hover { background: rgba(0,0,0,0.07); }

  .search-bar { padding: 0.4rem 1rem; border-radius: 20px; border: 1px solid var(--border-color); width: 240px; background: var(--bg-color); color: var(--text-color); font-size: 0.9rem; z-index: 301; position: relative; }   
  .icon-btn { background: none; border: none; font-size: 1.2rem; cursor: pointer; padding: 0.3rem; border-radius: 6px; }
  .icon-btn:hover { background: rgba(0,0,0,0.05); }

  @media (min-width: 1025px) { .hide-on-desktop { display: none !important; } } 
</style>

<script>
  function initHeader() {
    let searchData: any[] = [];
    const input = document.getElementById('search-input') as HTMLInputElement;
    const resultsBox = document.getElementById('search-results');
    const backdrop = document.getElementById('search-backdrop');

    // --- LÓGICA DE BÚSQUEDA Y TAGS ---
    // Usamos un clon o reemplazamos el listener limpiamente
    const newHandler = async (e: Event) => {
      const rawQuery = (e.target as HTMLInputElement).value.toLowerCase();
      
      if (rawQuery.length < 2) {
        if (resultsBox) resultsBox.style.display = 'none';
        if (backdrop) backdrop.style.display = 'none';
        return;
      }

      if (searchData.length === 0) {
        const res = await fetch('/search.json');
        searchData = await res.json();
      }

      const isTagSearch = rawQuery.startsWith('#');
      const query = isTagSearch ? rawQuery.slice(1).trim() : rawQuery;

      const filtered = searchData.filter(item => {
        const tagMatch = item.tags.some((tag: string) => tag.toLowerCase().includes(query));
        if (isTagSearch) return tagMatch;
        return item.title.toLowerCase().includes(query) || tagMatch;
      });

      if (resultsBox && backdrop) {
        resultsBox.innerHTML = '';
        if (filtered.length > 0) {
          filtered.forEach(item => {
            const li = document.createElement('li');
            li.innerHTML = `<a href="${item.url}">📄 ${item.title} ${item.tags.length > 0 ? `<small style="opacity:0.5">(${item.tags.join(', ')})</small>` : ''}</a>`;
            resultsBox.appendChild(li);
          });
        } else {
          resultsBox.innerHTML = '<li class="no-results">No se encontraron resultados</li>';
        }
        resultsBox.style.display = 'block';
        backdrop.style.display = 'block';
      }
    };

    // Limpiamos eventos anteriores clonando el input o asignando directamente
    if (input) {
      input.replaceWith(input.cloneNode(true));
      const freshInput = document.getElementById('search-input') as HTMLInputElement;
      freshInput?.addEventListener('input', newHandler);
    }

    // Cerrar buscador al hacer clic afuera
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (resultsBox && backdrop && !target.closest('.search-container') && !target.closest('.search-results')) {
        resultsBox.style.display = 'none';
        backdrop.style.display = 'none';
      }
    });

    // --- LÓGICA DE PÁGINA ALEATORIA ---
    const btnRandom = document.getElementById('btn-random');
    if (btnRandom) {
      btnRandom.replaceWith(btnRandom.cloneNode(true));
      const freshBtnRandom = document.getElementById('btn-random');
      freshBtnRandom?.addEventListener('click', async (e) => {
        e.preventDefault();
        if (searchData.length === 0) {
          const res = await fetch('/search.json');
          searchData = await res.json();
        }
        if (searchData.length > 0) {
          const random = searchData[Math.floor(Math.random() * searchData.length)];
          window.location.href = random.url;
        }
      });
    }

    // --- LÓGICA DEL MENÚ MÓVIL (LAS TRES LÍNEAS) ---
    const btnMobileMenu = document.getElementById('btn-mobile-menu');
    if (btnMobileMenu) {
      btnMobileMenu.replaceWith(btnMobileMenu.cloneNode(true));
      const freshBtnMobile = document.getElementById('btn-mobile-menu');
      freshBtnMobile?.addEventListener('click', () => {
        const leftPanel = document.querySelector('.left-panel');
        leftPanel?.classList.toggle('show-mobile-menu');
      });
    }

// --- ATAJOS DE TECLADO (BÚSQUEDA) ---
    document.addEventListener('keydown', (e) => {
      const searchInput = document.getElementById('search-input') as HTMLInputElement;
      const resultsBox = document.getElementById('search-results');
      const backdrop = document.getElementById('search-backdrop');

      // Abrir buscador (Cmd/Ctrl + K)
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        if (searchInput) searchInput.focus();
      }

      // Cerrar buscador (Esc)
      if (e.key === 'Escape') {
        if (resultsBox && backdrop) {
          resultsBox.style.display = 'none';
          backdrop.style.display = 'none';
        }
        if (searchInput) {
          searchInput.blur(); // Quita el parpadeo del cursor
        }
      }
    });
  }

  // Se ejecuta al cargar la página inicialmente y en cada transición de Astro
  document.addEventListener('astro:page-load', initHeader);
</script>